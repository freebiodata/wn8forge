---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://wn8forge.top';
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <style is:global>
      :root {
        --bg-main: #0d1117;
        --bg-card: #161b22;
        --border-color: #30363d;
        --text-main: #c9d1d9;
        --text-bright: #f0f6fc;
        --text-muted: #8b949e;
        --accent: #e5a93c;
        --accent-hover: #f3be5c;
        --green: #238636;
        --blue: #58a6ff;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: var(--font-sans);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      header {
        background-color: var(--bg-card);
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 1.5rem;
      }
      .nav-container {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-bright);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .brand span {
        color: var(--accent);
      }
      nav {
        display: flex;
        gap: 1.25rem;
      }
      nav a {
        color: var(--text-main);
        font-weight: 500;
      }
      nav a:hover {
        color: var(--accent);
        text-decoration: none;
      }
      main {
        flex: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        width: 100%;
      }
      footer {
        background-color: var(--bg-card);
        border-top: 1px solid var(--border-color);
        padding: 2rem 1.5rem;
        margin-top: 3rem;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.875rem;
      }
      .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.25rem;
        margin-top: 1.5rem;
      }
      h1, h2, h3 {
        color: var(--text-bright);
        margin-bottom: 0.75rem;
      }
      p {
        margin-bottom: 1rem;
      }
      input, select, button {
        background-color: #0d1117;
        color: var(--text-bright);
        border: 1px solid var(--border-color);
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        font-size: 1rem;
        width: 100%;
      }
      button {
        background-color: var(--accent);
        color: #0d1117;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: background-color 0.2s;
      }
      button:hover {
        background-color: var(--accent-hover);
      }
      .result-box {
        background-color: #090d13;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 1.25rem;
        margin-top: 1rem;
        text-align: center;
      }
      .result-value {
        font-size: 2.25rem;
        font-weight: 700;
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav-container">
        <a href="/" class="brand">WN8<span>Forge</span></a>
        <nav>
          <a href="/">Home</a>
          <a href="/wn8-calculator/">WN8 Calculator</a>
          <a href="/camo-calculator/">Camo & Spotting</a>
          <a href="/moe-projection/">Marks of Excellence</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; 2026 WN8Forge. Free, browser-based World of Tanks calculators.</p>
      <p>Not affiliated with or endorsed by Wargaming.net.</p>
    </footer>
  </body>
</html>
