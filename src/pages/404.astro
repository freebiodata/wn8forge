---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | WN8Forge"
  description="404 Page Not Found"
>
  <div style="text-align: center; padding: 4rem 1rem;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">404</h1>
    <p style="color: var(--text-muted); font-size: 1.25rem; margin-bottom: 2rem;">
      The page you were looking for does not exist.
    </p>
    <a href="/" style="display: inline-block; background: var(--accent); color: #0d1117; font-weight: 600; padding: 0.75rem 1.5rem; border-radius: 6px;">
      Return to Home
    </a>
  </div>
</BaseLayout>
